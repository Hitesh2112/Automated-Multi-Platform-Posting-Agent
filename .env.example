# ==============================================================================
# Multi-Platform Automated Posting System Configuration
# ==============================================================================

# Server configuration
HOST=0.0.0.0
PORT=4000
DEBUG=false

# ------------------------------------------------------------------------------
# Evaluation & Simulation Mode
# ------------------------------------------------------------------------------
# Set to 'true' to simulate successful realistic API posts across all platforms
# without requiring live personal credentials.
# Set to 'false' to enforce real credential authentication against platform APIs.
MOCK_MODE=false

# Request timeout in seconds for third-party HTTP calls
REQUEST_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 1. Telegram Bot API
# ------------------------------------------------------------------------------
# Create a bot via @BotFather on Telegram to obtain TELEGRAM_BOT_TOKEN.
# Add the bot as an administrator to your public channel.
# TELEGRAM_CHAT_ID can be the public @channel_username or channel ID (e.g. -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 2. Twitter / X API v2
# ------------------------------------------------------------------------------
# Register a project at https://developer.x.com/en/portal/dashboard.
# Enable OAuth 2.0 with tweet.read and tweet.write permissions.
# Provide the User Access Token or App Bearer Token.
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 3. LinkedIn UGC Post API
# ------------------------------------------------------------------------------
# Create an app at https://www.linkedin.com/developers/apps.
# Request 'w_member_social' or 'w_organization_social' scope.
# LINKEDIN_PERSON_URN is your member ID or organization ID (e.g. 'me' or 'urn:li:person:abcdef').
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# ------------------------------------------------------------------------------
# 4. Reddit OAuth2 API
# ------------------------------------------------------------------------------
# Register a 'script' application at https://www.reddit.com/prefs/apps.
# Note the client ID (under app name) and client secret.
# Provide the Reddit account username and password for password grant flow.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=test

# ------------------------------------------------------------------------------
# 5. GitHub Gist REST API
# ------------------------------------------------------------------------------
# Generate a Personal Access Token (classic or fine-grained) at:
# https://github.com/settings/tokens with 'gist' scope.
GITHUB_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 6. Meta Threads / Instagram API
# ------------------------------------------------------------------------------
# Register an app at https://developers.facebook.com for Threads API.
# Generate User Access Token with 'threads_basic' and 'threads_content_publish'.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
